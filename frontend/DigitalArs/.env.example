# Copiar este archivo como .env.local antes de levantar el frontend.
# Es la direccion base de la API, sin /api al final.
# Tiene que coincidir con el applicationUrl de Properties/launchSettings.json del backend.
# Si se cambia, hay que reiniciar Vite: no se recarga en caliente.
VITE_API_URL=https://localhost:7201
